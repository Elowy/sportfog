<div class="flex items-center gap-2 mb-4">
  <a href="/admin/meccsek" class="text-slate-400 hover:text-slate-600">← Meccsek</a>
</div>

<div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
  <div>
    <div class="text-sm text-slate-500"><%= match.league || 'Foci' %> · <%= formatDateTime(match.kickoffAt) %></div>
    <h1 class="text-2xl font-bold text-slate-900"><%= match.homeTeam %> – <%= match.awayTeam %></h1>
    <div class="text-sm text-slate-500 mt-1">Állapot: <%= (domain.MATCH_STATUSES[match.status] || {label: match.status}).label %></div>
  </div>
  <div class="flex gap-2">
    <a href="/admin/meccsek/<%= match.id %>/szerkeszt" class="px-3 py-2 rounded-lg bg-white border border-slate-200 text-sm font-semibold hover:border-brand">Szerkesztés</a>
    <form action="/admin/meccsek/<%= match.id %>/torles" method="post" onsubmit="return confirm('Biztosan törlöd a meccset és az összes tippjét?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="px-3 py-2 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm font-semibold hover:bg-red-100">Törlés</button>
    </form>
  </div>
</div>

<!-- Meglévő tippek -->
<h2 class="text-lg font-bold text-slate-900 mb-3">Tippek (<%= match.tips.length %>)</h2>
<% if (match.tips.length === 0) { %>
  <div class="bg-white rounded-xl border border-slate-200 p-6 text-center text-slate-500 mb-8">Ehhez a meccshez még nincs tipp. Add hozzá lentebb!</div>
<% } else { %>
  <div class="space-y-3 mb-8">
    <% match.tips.forEach(function(tip){
         var rInfo = domain.TIP_RESULTS[tip.result] || { label: tip.result };
         var rBadge = { WON:'bg-emerald-100 text-emerald-700', LOST:'bg-red-100 text-red-700', VOID:'bg-slate-100 text-slate-600', PENDING:'bg-amber-100 text-amber-700' }[tip.result] || 'bg-slate-100 text-slate-600'; %>
      <div class="bg-white rounded-xl border border-slate-200 p-4">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-semibold uppercase text-slate-500"><%= domain.betTypeLabel(tip.betType) %></span>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200"><%= domain.tierLabel(tip.requiredTier) %></span>
              <span class="text-[11px] px-2 py-0.5 rounded-full <%= rBadge %>"><%= rInfo.label %></span>
            </div>
            <div class="mt-1 font-semibold text-slate-900">
              <%= tip.selection %><% if (tip.line !== null && tip.line !== undefined) { %> (<%= tip.line %>)<% } %>
              <% if (tip.odds) { %><span class="text-brand ml-2">@ <%= tip.odds.toFixed(2) %></span><% } %>
              <% if (tip.confidence) { %><span class="text-amber-500 ml-2"><%= '★'.repeat(tip.confidence) %></span><% } %>
            </div>
            <% if (tip.analysis) { %><p class="text-sm text-slate-600 mt-1"><%= tip.analysis %></p><% } %>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a href="/admin/tippek/<%= tip.id %>/szerkeszt" class="text-sm text-brand font-semibold hover:underline">Szerkesztés</a>
            <form action="/admin/tippek/<%= tip.id %>/torles" method="post" onsubmit="return confirm('Törlöd a tippet?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="text-sm text-red-600 hover:underline">Törlés</button>
            </form>
          </div>
        </div>
        <!-- Gyors eredmény -->
        <div class="mt-3 flex items-center gap-2 flex-wrap border-t border-slate-100 pt-3">
          <span class="text-xs text-slate-500">Eredmény:</span>
          <% domain.TIP_RESULT_ORDER.forEach(function(rc){ %>
            <form action="/admin/tippek/<%= tip.id %>/eredmeny" method="post" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="result" value="<%= rc %>" />
              <button type="submit" class="text-xs px-2 py-1 rounded border <%= tip.result === rc ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 border-slate-200 hover:border-brand' %>"><%= domain.TIP_RESULTS[rc].label %></button>
            </form>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Új tipp hozzáadása -->
<h2 class="text-lg font-bold text-slate-900 mb-3">Új tipp hozzáadása</h2>
<datalist id="selectionSuggestions">
  <% betTypeOrder.forEach(function(code){ betTypes[code].selections.forEach(function(s){ %>
    <option value="<%= s %>"></option>
  <% }) }) %>
</datalist>

<form action="/admin/meccsek/<%= match.id %>/tippek" method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4 max-w-3xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Fogadás típusa *</label>
      <select name="betType" required class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand">
        <% betTypeOrder.forEach(function(code){ %>
          <option value="<%= code %>"><%= betTypes[code].label %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Tipp (kimenetel) *</label>
      <input type="text" name="selection" required list="selectionSuggestions" placeholder="pl. Hazai (1), Over, Igen"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
  </div>
  <div class="grid sm:grid-cols-4 gap-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Vonal (line)</label>
      <input type="number" step="0.25" name="line" placeholder="pl. 2.5"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Odds</label>
      <input type="number" step="0.01" name="odds" placeholder="pl. 1.85"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Bizalom (1–5)</label>
      <input type="number" min="1" max="5" name="confidence" placeholder="1–5"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Tét egység (1–10)</label>
      <input type="number" min="1" max="10" name="stake" placeholder="1–10"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Szükséges szint</label>
    <select name="requiredTier" class="w-full sm:w-1/2 rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand">
      <% tierOrder.forEach(function(code){ %>
        <option value="<%= code %>"><%= tiers[code].label %></option>
      <% }) %>
    </select>
    <p class="text-xs text-slate-500 mt-1">Csak az ezen (vagy magasabb) szintű előfizetők látják a tipp részleteit.</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Elemzés / indoklás</label>
    <textarea name="analysis" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" placeholder="Miért ez a tipp?"></textarea>
  </div>
  <% if (notifyAvailable) { %>
    <label class="flex items-center gap-2 text-sm text-slate-700">
      <input type="checkbox" name="notify" checked class="h-4 w-4" />
      Értesítés küldése a jogosult felhasználóknak (e-mail / Telegram / Messenger / böngésző)
    </label>
  <% } %>
  <button type="submit" class="px-5 py-2.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-dark">Tipp hozzáadása</button>
</form>
