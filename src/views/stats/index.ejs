<%
  function pct(v){ return v === null || v === undefined ? '–' : Math.round(v * 100) + '%'; }
  function qs(over){
    var p = Object.assign({ honap: filters.honap, tol: filters.tol, ig: filters.ig, liga: filters.liga, csapat: filters.csapat, tipus: filters.tipus, bontas: bontas }, over || {});
    return '/statisztika?' + Object.keys(p).filter(function(k){ return p[k] !== '' && p[k] != null; }).map(function(k){ return k + '=' + encodeURIComponent(p[k]); }).join('&');
  }
  var bontasLabels = { honap: 'Havi', liga: 'Liga', csapat: 'Csapat', tipus: 'Fogadás típusa' };
%>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <h1 class="text-2xl font-bold text-slate-900">Statisztika</h1>
  <a href="/fiok" class="text-sm font-semibold text-brand hover:underline">← Fiókom</a>
</div>

<!-- Szűrők -->
<form action="/statisztika" method="get" class="bg-white border border-slate-200 rounded-xl p-4 mb-6">
  <input type="hidden" name="bontas" value="<%= bontas %>" />
  <div class="mb-3">
    <div class="text-xs font-semibold text-slate-500 uppercase mb-2">Gyors hónapválasztás</div>
    <div class="flex flex-wrap gap-2">
      <% months.forEach(function(m){ var active = filters.honap === m.key; %>
        <a href="<%= qs({ honap: m.key, tol: '', ig: '' }) %>"
           class="px-3 py-1.5 rounded-full text-sm border <%= active ? 'bg-brand text-white border-brand' : 'bg-white text-slate-600 border-slate-200 hover:border-brand' %>"><%= m.label %></a>
      <% }) %>
      <a href="/statisztika?bontas=<%= bontas %>" class="px-3 py-1.5 rounded-full text-sm border bg-white text-slate-500 border-slate-200 hover:border-brand">Összes</a>
    </div>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Ettől</label>
      <input type="date" name="tol" value="<%= filters.tol %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Eddig</label>
      <input type="date" name="ig" value="<%= filters.ig %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Liga</label>
      <select name="liga" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Összes</option>
        <% leagues.forEach(function(l){ %><option value="<%= l %>" <%= filters.liga === l ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Csapat</label>
      <select name="csapat" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Összes</option>
        <% teams.forEach(function(t){ %><option value="<%= t %>" <%= filters.csapat === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Típus</label>
      <select name="tipus" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Összes</option>
        <% betTypeOrder.forEach(function(code){ %><option value="<%= code %>" <%= filters.tipus === code ? 'selected' : '' %>><%= domain.BET_TYPES[code].label %></option><% }) %>
      </select>
    </div>
  </div>
  <div class="mt-3 flex gap-2">
    <button type="submit" class="px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-semibold hover:bg-slate-700">Szűrés</button>
    <a href="/statisztika" class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 text-sm font-semibold hover:bg-slate-200">Alaphelyzet</a>
  </div>
</form>

<!-- Összesítő -->
<section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-8">
  <div class="bg-white rounded-xl border border-slate-200 p-4 text-center"><div class="text-2xl font-extrabold text-slate-900"><%= summary.total %></div><div class="text-xs text-slate-500">Lezárt tipp</div></div>
  <div class="bg-white rounded-xl border border-slate-200 p-4 text-center"><div class="text-2xl font-extrabold text-emerald-600"><%= summary.won %></div><div class="text-xs text-slate-500">Nyert</div></div>
  <div class="bg-white rounded-xl border border-slate-200 p-4 text-center"><div class="text-2xl font-extrabold text-red-500"><%= summary.lost %></div><div class="text-xs text-slate-500">Vesztett</div></div>
  <div class="bg-white rounded-xl border border-slate-200 p-4 text-center"><div class="text-2xl font-extrabold text-brand"><%= pct(summary.winRate) %></div><div class="text-xs text-slate-500">Találati arány</div></div>
  <div class="bg-white rounded-xl border border-slate-200 p-4 text-center"><div class="text-2xl font-extrabold text-slate-900"><%= summary.avgOdds ? summary.avgOdds.toFixed(2) : '–' %></div><div class="text-xs text-slate-500">Átlag odds</div></div>
</section>

<!-- Bontás -->
<div class="flex items-center gap-2 mb-3 flex-wrap">
  <h2 class="text-lg font-bold text-slate-900 mr-2">Összesítő bontás</h2>
  <% ['honap','liga','csapat','tipus'].forEach(function(b){ %>
    <a href="<%= qs({ bontas: b }) %>" class="px-3 py-1 rounded-full text-sm border <%= bontas === b ? 'bg-brand text-white border-brand' : 'bg-white text-slate-600 border-slate-200 hover:border-brand' %>"><%= bontasLabels[b] %></a>
  <% }) %>
</div>

<div class="bg-white rounded-xl border border-slate-200 overflow-hidden mb-8">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-4 py-3 font-medium"><%= bontasLabels[bontas] %></th>
          <th class="px-4 py-3 font-medium text-center">Tipp</th>
          <th class="px-4 py-3 font-medium text-center">Ny</th>
          <th class="px-4 py-3 font-medium text-center">V</th>
          <th class="px-4 py-3 font-medium text-center">Találati %</th>
          <th class="px-4 py-3 font-medium text-center">Átlag odds</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (groups.length === 0) { %>
          <tr><td colspan="6" class="px-4 py-6 text-center text-slate-500">Nincs adat a szűrőkhöz.</td></tr>
        <% } %>
        <% groups.forEach(function(g){ %>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-800"><%= g.label %></td>
            <td class="px-4 py-3 text-center text-slate-600"><%= g.total %></td>
            <td class="px-4 py-3 text-center text-emerald-600"><%= g.won %></td>
            <td class="px-4 py-3 text-center text-red-500"><%= g.lost %></td>
            <td class="px-4 py-3 text-center"><%= pct(g.winRate) %></td>
            <td class="px-4 py-3 text-center text-slate-600"><%= g.avgOdds ? g.avgOdds.toFixed(2) : '–' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Részletes meccslista -->
<h2 class="text-lg font-bold text-slate-900 mb-3">Meccsek elemzése (<%= detailMatches.length %>)</h2>
<% if (detailMatches.length === 0) { %>
  <div class="bg-white rounded-xl border border-slate-200 p-8 text-center text-slate-500">Nincs lezárt tipp a kiválasztott szűrőkkel.</div>
<% } else { %>
  <div class="space-y-3">
    <% detailMatches.forEach(function(match){ %>
      <div class="bg-white rounded-xl border border-slate-200 p-4">
        <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
          <span class="font-semibold"><%= match.league || 'Foci' %></span>
          <span><%= formatDateTime(match.kickoffAt) %></span>
        </div>
        <div class="font-bold text-slate-900 mb-1"><%= match.homeTeam %> – <%= match.awayTeam %></div>
        <div class="divide-y divide-slate-100">
          <% match.tips.forEach(function(tip){
               var rBadge = { WON:'bg-emerald-100 text-emerald-700', LOST:'bg-red-100 text-red-700', VOID:'bg-slate-100 text-slate-600' }[tip.result] || 'bg-slate-100 text-slate-600';
               var rLabel = (domain.TIP_RESULTS[tip.result] || { label: tip.result }).label; %>
            <div class="flex items-center justify-between gap-3 py-2">
              <div class="min-w-0">
                <span class="text-[11px] font-semibold uppercase text-slate-500"><%= domain.betTypeLabel(tip.betType) %></span>
                <div class="text-sm font-medium text-slate-800"><%= tip.selection %><% if (tip.line !== null && tip.line !== undefined) { %> (<%= tip.line %>)<% } %><% if (tip.odds) { %> <span class="text-slate-400">@ <%= tip.odds.toFixed(2) %></span><% } %></div>
              </div>
              <span class="text-[11px] px-2 py-0.5 rounded-full shrink-0 <%= rBadge %>"><%= rLabel %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
