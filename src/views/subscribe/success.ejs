<div class="max-w-xl mx-auto text-center py-12">
  <div class="text-6xl mb-4">✅</div>
  <h1 class="text-2xl font-bold text-slate-900 mb-2">Sikeres fizetés!</h1>
  <% if (grant) { %>
    <p class="text-slate-600 mb-2">
      Aktiváltuk a(z) <strong><%= domain.tierLabel(grant.tier) %></strong> szintű hozzáférésedet.
    </p>
    <p class="text-slate-600 mb-6">Érvényes eddig: <strong><%= formatDateTime(grant.expiresAt) %></strong></p>
  <% } else { %>
    <p class="text-slate-600 mb-6">
      Köszönjük a vásárlást! A hozzáférésed pár másodpercen belül aktiválódik. Ha nem látod azonnal, frissítsd a Fiókom oldalt.
    </p>
  <% } %>
  <div class="flex justify-center gap-3">
    <a href="/tippek" class="px-5 py-2.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-dark">Tippek megtekintése</a>
    <a href="/fiok" class="px-5 py-2.5 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200">Fiókom</a>
  </div>
</div>
