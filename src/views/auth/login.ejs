<div class="max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-slate-900 mb-6 text-center">Bejelentkezés</h1>

  <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm mb-4">
      <ul class="list-disc list-inside space-y-1">
        <% errors.forEach(function(e){ %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/belepes" method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">E-mail cím</label>
      <input type="email" name="email" required value="<%= values.email || '' %>"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Jelszó</label>
      <input type="password" name="password" required
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <button type="submit" class="w-full py-2.5 rounded-lg bg-brand hover:bg-brand-dark text-white font-semibold">Belépés</button>
  </form>

  <p class="text-center text-sm text-slate-600 mt-4">
    Még nincs fiókod? <a href="/regisztracio" class="text-brand font-semibold hover:underline">Regisztrálj!</a>
  </p>
</div>
