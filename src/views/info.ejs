<div class="max-w-xl mx-auto text-center py-16">
  <div class="text-6xl mb-4"><%= typeof icon !== 'undefined' ? icon : '✅' %></div>
  <h1 class="text-2xl font-bold text-slate-900 mb-2"><%= typeof title !== 'undefined' ? title : 'Kész' %></h1>
  <p class="text-slate-600 mb-6"><%= typeof message !== 'undefined' ? message : '' %></p>
  <a href="/" class="inline-block px-4 py-2 rounded-lg bg-brand text-white font-semibold hover:bg-brand-dark">Vissza a kezdőlapra</a>
</div>
