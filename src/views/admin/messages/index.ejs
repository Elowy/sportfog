<h1 class="text-2xl font-bold text-slate-900 mb-2">Messenger üzenetek</h1>
<p class="text-slate-600 mb-6 text-sm">Kézi körüzenet küldése a Messengerrel összekapcsolt felhasználóknak.</p>

<% if (!messengerEnabled) { %>
  <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-lg px-4 py-3 text-sm mb-6">
    A Messenger nincs beállítva (hiányzó <code>MESSENGER_PAGE_ACCESS_TOKEN</code>). A küldés nem elérhető.
  </div>
<% } %>

<div class="grid grid-cols-2 gap-4 mb-6 max-w-md">
  <div class="bg-white rounded-xl border border-slate-200 p-4">
    <div class="text-2xl font-extrabold text-slate-900"><%= stats.linked %></div>
    <div class="text-sm text-slate-500">Összekapcsolt fiók</div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200 p-4">
    <div class="text-2xl font-extrabold text-emerald-600"><%= stats.optedIn %></div>
    <div class="text-sm text-slate-500">Értesítést kér</div>
  </div>
</div>

<% if (result) { %>
  <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg px-4 py-3 text-sm mb-6">
    Elküldve: <strong><%= result.sent %></strong> · Hiba: <strong><%= result.failed %></strong> · Címzettek: <strong><%= result.total %></strong>
  </div>
<% } %>

<form action="/admin/uzenetek" method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4 max-w-2xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Címzettek</label>
    <select name="audience" class="w-full sm:w-72 rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand">
      <option value="linked">Összes összekapcsolt felhasználó</option>
      <option value="active">Csak aktív előfizetők</option>
      <option value="BASIC">Alap szinttől felfelé</option>
      <option value="PREMIUM">Prémium szinttől felfelé</option>
      <option value="VIP">Csak VIP</option>
    </select>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Üzenet</label>
    <textarea name="text" rows="5" maxlength="1900" required
      class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand"
      placeholder="Írd ide az üzenetet..."><%= sentText || '' %></textarea>
    <p class="text-xs text-slate-500 mt-1">Max. 1900 karakter. Csak azokat éri el, akik nemrég írtak a botnak (Messenger 24 órás szabály).</p>
  </div>
  <button type="submit" <%= messengerEnabled ? '' : 'disabled' %>
    class="px-5 py-2.5 rounded-lg text-white font-semibold <%= messengerEnabled ? 'bg-brand hover:bg-brand-dark' : 'bg-slate-300 cursor-not-allowed' %>">
    Körüzenet küldése
  </button>
</form>
