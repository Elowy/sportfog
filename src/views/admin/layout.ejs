<!DOCTYPE html>
<html lang="hu" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title : 'Admin' %> – <%= siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { DEFAULT: '#4f46e5', dark: '#4338ca' } } } } };
  </script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="h-full bg-slate-100 text-slate-800">
  <div class="min-h-full flex flex-col md:flex-row">
    <!-- Oldalsáv -->
    <aside class="md:w-64 bg-slate-900 text-slate-300 md:min-h-screen">
      <div class="px-5 py-4 border-b border-slate-800">
        <a href="/admin" class="flex items-center gap-2 text-white font-bold">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-brand">⚽</span>
          <span><%= siteName %> admin</span>
        </a>
      </div>
      <% function aClass(path, current){ return (current === path || (path !== '/admin' && current.indexOf(path) === 0)) ? 'block px-5 py-2.5 bg-slate-800 text-white border-l-2 border-brand' : 'block px-5 py-2.5 hover:bg-slate-800 hover:text-white border-l-2 border-transparent'; } %>
      <nav class="py-3 text-sm">
        <a href="/admin" class="<%= aClass('/admin', currentPath) %>">Irányítópult</a>
        <a href="/admin/meccsek" class="<%= aClass('/admin/meccsek', currentPath) %>">Meccsek &amp; tippek</a>
        <a href="/admin/csomagok" class="<%= aClass('/admin/csomagok', currentPath) %>">Csomagok &amp; árak</a>
        <a href="/admin/felhasznalok" class="<%= aClass('/admin/felhasznalok', currentPath) %>">Felhasználók</a>
      </nav>
      <div class="px-5 py-4 border-t border-slate-800 text-xs space-y-2">
        <a href="/" class="block hover:text-white">← Vissza az oldalra</a>
        <form action="/kilepes" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="hover:text-white">Kilépés</button>
        </form>
      </div>
    </aside>

    <!-- Tartalom -->
    <main class="flex-1 p-6 max-w-5xl">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
</body>
</html>
