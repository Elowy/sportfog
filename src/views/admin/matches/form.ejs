<%
  function toLocalInput(v){
    if(!v) return '';
    if (typeof v === 'string') return v.slice(0,16);
    var d = new Date(v);
    var p = function(n){ return String(n).padStart(2,'0'); };
    return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());
  }
  var isEdit = match && match.id;
  var action = isEdit ? ('/admin/meccsek/' + match.id) : '/admin/meccsek';
%>

<div class="flex items-center gap-2 mb-6">
  <a href="/admin/meccsek" class="text-slate-400 hover:text-slate-600">← Meccsek</a>
</div>
<h1 class="text-2xl font-bold text-slate-900 mb-6"><%= isEdit ? 'Meccs szerkesztése' : 'Új meccs' %></h1>

<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
  <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm mb-4">
    <ul class="list-disc list-inside space-y-1"><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>

<form action="<%= action %>" method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4 max-w-2xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Liga / bajnokság</label>
    <input type="text" name="league" value="<%= match && match.league ? match.league : '' %>" placeholder="pl. OTP Bank Liga"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Hazai csapat *</label>
      <input type="text" name="homeTeam" required value="<%= match && match.homeTeam ? match.homeTeam : '' %>"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Vendég csapat *</label>
      <input type="text" name="awayTeam" required value="<%= match && match.awayTeam ? match.awayTeam : '' %>"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Kezdés időpontja *</label>
      <input type="datetime-local" name="kickoffAt" required value="<%= toLocalInput(match && match.kickoffAt) %>"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Állapot</label>
      <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand">
        <% Object.keys(statuses).forEach(function(code){
             var sel = match && match.status === code ? 'selected' : ''; %>
          <option value="<%= code %>" <%= sel %>><%= statuses[code].label %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Megjegyzés</label>
    <textarea name="note" rows="2" class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand"><%= match && match.note ? match.note : '' %></textarea>
  </div>
  <div class="flex gap-3 pt-2">
    <button type="submit" class="px-5 py-2.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-dark"><%= isEdit ? 'Mentés' : 'Meccs létrehozása' %></button>
    <a href="/admin/meccsek" class="px-5 py-2.5 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200">Mégse</a>
  </div>
</form>
