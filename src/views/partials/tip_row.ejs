<%
  var reveal = (typeof reveal !== 'undefined') && reveal;
  var reqRank = domain.tierRank(tip.requiredTier);
  var canView = reveal || (access && access.effectiveRank >= reqRank);
  var tierInfo = domain.TIERS[tip.requiredTier] || { label: tip.requiredTier, color: 'slate' };
  var resultInfo = domain.TIP_RESULTS[tip.result] || { label: tip.result, color: 'slate' };
  var tierBadge = {
    BASIC: 'bg-slate-100 text-slate-700 border-slate-200',
    PREMIUM: 'bg-indigo-100 text-indigo-700 border-indigo-200',
    VIP: 'bg-amber-100 text-amber-800 border-amber-200'
  }[tip.requiredTier] || 'bg-slate-100 text-slate-700 border-slate-200';
  var resultBadge = {
    WON: 'bg-emerald-100 text-emerald-700 border-emerald-200',
    LOST: 'bg-red-100 text-red-700 border-red-200',
    VOID: 'bg-slate-100 text-slate-600 border-slate-200',
    PENDING: 'bg-slate-50 text-slate-500 border-slate-200'
  }[tip.result] || 'bg-slate-50 text-slate-500 border-slate-200';
%>
<div class="flex items-start justify-between gap-3 py-3 border-t border-slate-100 first:border-t-0">
  <div class="min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= domain.betTypeLabel(tip.betType) %></span>
      <span class="text-[11px] px-2 py-0.5 rounded-full border <%= tierBadge %>"><%= tierInfo.label %></span>
      <% if (tip.result && tip.result !== 'PENDING') { %>
        <span class="text-[11px] px-2 py-0.5 rounded-full border <%= resultBadge %>"><%= resultInfo.label %></span>
      <% } %>
    </div>

    <% if (canView) { %>
      <div class="mt-1 font-semibold text-slate-900">
        <%= tip.selection %><% if (tip.line !== null && tip.line !== undefined) { %> <span class="text-slate-500 font-normal">(<%= tip.line %>)</span><% } %>
      </div>
      <% if (tip.analysis) { %>
        <p class="mt-1 text-sm text-slate-600"><%= tip.analysis %></p>
      <% } %>
    <% } else { %>
      <div class="mt-1 flex items-center gap-2 text-slate-400">
        <span>🔒</span>
        <span class="italic">Rejtett tipp – <%= tierInfo.label %> előfizetés szükséges</span>
      </div>
    <% } %>
  </div>

  <div class="text-right shrink-0">
    <% if (canView && tip.odds) { %>
      <div class="text-lg font-bold text-brand"><%= tip.odds.toFixed(2) %></div>
      <div class="text-[11px] text-slate-500">odds</div>
    <% } else if (!canView) { %>
      <a href="/elofizetes" class="inline-block text-xs font-semibold text-brand hover:underline">Feloldás</a>
    <% } %>
    <% if (canView && tip.confidence) { %>
      <div class="mt-1 text-amber-500 text-sm" title="Bizalmi szint: <%= tip.confidence %>/5"><%= '★'.repeat(tip.confidence) %><span class="text-slate-300"><%= '★'.repeat(Math.max(0, 5 - tip.confidence)) %></span></div>
    <% } %>
  </div>
</div>
