# ==========================================================================
#  Sportfog – környezeti változók
#  Másold át ezt a fájlt ".env" néven, és töltsd ki a saját adataiddal.
# ==========================================================================

# --- Általános ---
NODE_ENV=development
PORT=3000
# Az oldal nyilvános URL-je (Stripe visszairányításokhoz, webhookhoz)
BASE_URL=http://localhost:3000

# Session titkosító kulcs – éles környezetben CSERÉLD le egy hosszú véletlen értékre!
SESSION_SECRET=valamilyen-hosszu-veletlen-titok-cserelj-le

# --- Adatbázis (Prisma) ---
# SQLite (alapértelmezett, nem kell külön adatbázis-szerver):
DATABASE_URL="file:./dev.db"
# PostgreSQL-hez állítsd át a prisma/schema.prisma provider mezőjét "postgresql"-re
# és használd pl.: postgresql://user:pass@localhost:5432/sportfog

# --- Admin felhasználó (a seed script ezzel hozza létre az első admint) ---
ADMIN_EMAIL=admin@sportfog.hu
ADMIN_PASSWORD=valtoztasd-meg-ezt
ADMIN_NAME=Adminisztrátor

# --- Stripe ---
# A Stripe Dashboard > Developers > API keys oldalról
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# A webhook aláírás-ellenőrző titka (Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Pénznem (Stripe oldali), a magyar piacra HUF
STRIPE_CURRENCY=huf

# --- Számlázz.hu (Számla Agent) ---
# Agent kulcs a Számlázz.hu fiók irányítópultjáról ("Számla Agent kulcsok").
# Ha üresen hagyod, a számlázás kikapcsol (a fizetés és hozzáférés ettől még működik).
SZAMLAZZ_AGENT_KEY=
# A számlázz e-számlát állítson-e ki (true/false)
SZAMLAZZ_ESZAMLA=false
# A vásárlónak küldjön-e e-mailt a számláról a Számlázz.hu (true/false)
SZAMLAZZ_SEND_EMAIL=true
# Számlaszám előtag (a Számlázz.hu fiókban létrehozott előtag), pl. SPORTFOG
SZAMLAZZ_PREFIX=
# Fizetési mód felirat a számlán
SZAMLAZZ_PAYMENT_METHOD=bankkártya
# ÁFA kulcs a számlatételhez: szám (pl. 27, 5, 0) vagy szöveges kulcs
# (pl. AM = alanyi adómentes, TAM = tárgyi adómentes). A megadott ár BRUTTÓ árnak számít.
SZAMLAZZ_VAT_RATE=27

# --- Facebook Messenger (értesítések) ---
# Meta App + Facebook oldal szükséges. Ha üresen hagyod, a Messenger funkció kikapcsol.
# Page Access Token (Meta App > Messenger > Settings > Generate token az oldaladhoz)
MESSENGER_PAGE_ACCESS_TOKEN=
# Tetszőleges saját titok – ugyanezt add meg a webhook beállításnál (Verify Token)
MESSENGER_VERIFY_TOKEN=
# App Secret (Meta App > Settings > Basic) – a webhook aláírás-ellenőrzéshez
MESSENGER_APP_SECRET=
# Az oldalad felhasználóneve az m.me/<username> linkhez (pl. sportfog)
MESSENGER_PAGE_USERNAME=
# Graph API verzió
MESSENGER_API_VERSION=v21.0

# --- Telegram (értesítések) ---
# BotFather-től kapott token. Ha üres, a Telegram funkció kikapcsol.
TELEGRAM_BOT_TOKEN=
# A bot felhasználóneve @ nélkül (a t.me/<username> linkhez)
TELEGRAM_BOT_USERNAME=
# Tetszőleges titok a webhook védelméhez (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sportfog <no-reply@sportfog.hu>

# --- Web Push (böngésző értesítés, VAPID) ---
# Generálható az admin Beállítások oldalon egy gombbal, vagy: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sportfog.hu

# MEGJEGYZÉS: a fenti integrációs kulcsok (Stripe, Számlázz, Messenger, Telegram,
# e-mail, Web Push) az ADMIN FELÜLETEN is szerkeszthetők (Admin → Beállítások).
# Az ott megadott érték felülírja az itteni .env értéket.
